<Window
    x:Class="FileSyncX.Views.PdfBatchProcessingWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    mc:Ignorable="d"
    x:CompileBindings="False"
    Title="Processamento semântico de PDFs"
    Width="1180"
    Height="820"
    MinWidth="920"
    MinHeight="650"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource AppToolbarBg}">

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Padding="22,18" Background="{DynamicResource AppPrimaryDark}">
            <StackPanel Orientation="Horizontal" Spacing="14">
                <Border Width="44" Height="44" CornerRadius="8" Background="{DynamicResource AppWhite}" Padding="8">
                    <materialIcons:MaterialIcon Kind="Brain" Width="28" Height="28" Foreground="{DynamicResource AppPrimaryDark}" />
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="3">
                    <TextBlock Text="Classificação semântica de documentos" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppWhite}" />
                    <TextBlock Text="OCR, embeddings, busca vetorial e classificação pelo VecktorVault" FontSize="12" Foreground="{DynamicResource AppWhite}" Opacity="0.82" />
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22" Spacing="14">
                <Border Padding="18" CornerRadius="8" Background="{DynamicResource AppSurface}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="PASTA DE ORIGEM" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondary}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBox Grid.Column="0"
                                     Text="{Binding PastaOrigem, Mode=TwoWay}"
                                     VerticalContentAlignment="Center"
                                     PlaceholderText="Selecione ou informe o caminho da pasta contendo PDFs..." />
                            <Button Grid.Column="1" Click="SelecionarPasta_Click" Padding="16,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <materialIcons:MaterialIcon Kind="FolderOpen" Width="18" Height="18" />
                                    <TextBlock Text="Selecionar pasta" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="18" Margin="0,6,0,0">
                            <CheckBox Grid.Column="0" Content="Incluir subpastas" IsChecked="{Binding IncluirSubpastas, Mode=TwoWay}" />
                            <CheckBox Grid.Column="1" Content="Mover PDFs classificados" IsChecked="{Binding MoverSeClassificado, Mode=TwoWay}" />
                            <StackPanel Grid.Column="2" Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Similaridade mínima" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SimilaridadeFormatada}" FontWeight="Bold" Foreground="{DynamicResource AppPrimary}" />
                                </Grid>
                                <Slider Minimum="0.50" Maximum="0.95" SmallChange="0.01" LargeChange="0.05"
                                        Value="{Binding SimilaridadeMinima, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="A movimentação é opcional e permanece desativada por padrão. Documentos abaixo do limite de similaridade ficam para revisão." FontSize="11" Foreground="{DynamicResource AppTextSecondary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Padding="18" CornerRadius="8" Background="{DynamicResource AppSurface}">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock Text="PROCESSAMENTO DO LOTE" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondary}" />
                                <TextBlock Text="{Binding MensagemStatus}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding IniciarProcessamentoCommand}" IsEnabled="{Binding PodeIniciar}" Padding="18,9" Background="{DynamicResource AppPrimary}" Foreground="{DynamicResource AppWhite}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <materialIcons:MaterialIcon Kind="Play" Width="18" Height="18" Foreground="{DynamicResource AppWhite}" />
                                    <TextBlock Text="Iniciar lote" FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Command="{Binding CancelarProcessamentoCommand}" IsEnabled="{Binding PodeCancelar}" Padding="18,9">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <materialIcons:MaterialIcon Kind="Cancel" Width="18" Height="18" />
                                    <TextBlock Text="Cancelar" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding PercentualProgresso}" Height="10" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding ArquivoAtual}" Foreground="{DynamicResource AppTextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding Processados, StringFormat='{}{0} processado(s)'}" Foreground="{DynamicResource AppTextSecondary}" FontSize="11" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="8">
                    <Border Grid.Column="0" Padding="12" CornerRadius="6" Background="{DynamicResource AppSurface}">
                        <StackPanel Spacing="3"><TextBlock Text="Encontrados" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/><TextBlock Text="{Binding TotalEncontrado}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/></StackPanel>
                    </Border>
                    <Border Grid.Column="1" Padding="12" CornerRadius="6" Background="{DynamicResource AppSurface}">
                        <StackPanel Spacing="3"><TextBlock Text="Sucesso" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/><TextBlock Text="{Binding Sucesso}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AppSuccess}"/></StackPanel>
                    </Border>
                    <Border Grid.Column="2" Padding="12" CornerRadius="6" Background="{DynamicResource AppSurface}">
                        <StackPanel Spacing="3"><TextBlock Text="Falhas" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/><TextBlock Text="{Binding Falhas}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AppError}"/></StackPanel>
                    </Border>
                    <Border Grid.Column="3" Padding="12" CornerRadius="6" Background="{DynamicResource AppSurface}">
                        <StackPanel Spacing="3"><TextBlock Text="Classificados" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/><TextBlock Text="{Binding Classificados}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AppSuccess}"/></StackPanel>
                    </Border>
                    <Border Grid.Column="4" Padding="12" CornerRadius="6" Background="{DynamicResource AppSurface}">
                        <StackPanel Spacing="3"><TextBlock Text="Revisão" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/><TextBlock Text="{Binding ParaRevisao}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AppWarning}"/></StackPanel>
                    </Border>
                    <Border Grid.Column="5" Padding="12" CornerRadius="6" Background="{DynamicResource AppSurface}">
                        <StackPanel Spacing="3"><TextBlock Text="Já indexados" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/><TextBlock Text="{Binding JaIndexados}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/></StackPanel>
                    </Border>
                </Grid>

                <Border Padding="14" CornerRadius="8" Background="{DynamicResource AppSurface}">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="RESULTADOS POR DOCUMENTO" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondary}" />
                            <TextBlock Grid.Column="1" Text="{Binding Movidos, StringFormat='{}{0} movido(s)'}" FontSize="11" Foreground="{DynamicResource AppTextSecondary}" />
                        </Grid>
                        <DataGrid ItemsSource="{Binding Resultados}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Height="300"
                                  GridLinesVisibility="Horizontal"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  CanUserSortColumns="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ARQUIVO" Binding="{Binding SourceFile}" Width="2*" />
                                <DataGridTextColumn Header="STATUS" Binding="{Binding ClassificationStatus}" Width="100" />
                                <DataGridTextColumn Header="SIMILARIDADE" Binding="{Binding Similarity}" Width="110" />
                                <DataGridTextColumn Header="CATEGORIA" Binding="{Binding Category}" Width="*" />
                                <DataGridTextColumn Header="MOVIDO" Binding="{Binding Moved}" Width="75" />
                                <DataGridTextColumn Header="ERRO" Binding="{Binding ErrorMessage}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{Binding AvisosTexto}" IsVisible="{Binding TemAvisos}" Foreground="{DynamicResource AppWarning}" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
